{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=MonitorAgentWebsite;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Identity": {
    "PortalUrl": "http://localhost:4200"
  },
  "Email": {
    "Provider": "Smtp",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "EnableSsl": false,
      "From": "Monitor Agent <no-reply@monitoragent.local>"
    }
  }
}
