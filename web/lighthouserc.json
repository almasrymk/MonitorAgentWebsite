{
  "ci": {
    "collect": {
      "startServerCommand": "node e2e/site-stack.mjs",
      "startServerReadyPattern": "site stack listening",
      "url": [
        "http://localhost:4400/ar",
        "http://localhost:4400/en",
        "http://localhost:4400/en/pricing",
        "http://localhost:4400/ar/download",
        "http://localhost:4400/en/pages/about-us"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-results" }
  }
}
