# Copy to .env next to docker-compose.yml and fill in. .env holds secrets: keep it on the server only,
# readable by root, and never commit it. On Azure the same names go into Key Vault / App Service settings.

# --- The edge (Caddy) ---
# The public address. Caddy gets the TLS certificate for it from Let's Encrypt; DNS must already point here.
DOMAIN=monitoragent.example
# Let's Encrypt writes here when a certificate is about to expire and renewal keeps failing.
ACME_EMAIL=ops@monitoragent.example
# The host name the website answers to (the website's server refuses any other Host header).
SITE_HOST=monitoragent.example

# --- The API ---
ConnectionStrings__Default=Server=sqlserver;Database=MonitorAgentWebsite;User Id=monitoragent_app;Password=CHANGE-ME;TrustServerCertificate=True;Encrypt=True
Portal__Url=https://monitoragent.example/portal

Email__Provider=Smtp
Email__Smtp__Host=smtp.example
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__UserName=
Email__Smtp__Password=
Email__Smtp__From=Monitor Agent <no-reply@monitoragent.example>
Support__DemoRequestsEmail=sales@monitoragent.example

# The website's LicensingPlatform API client (E7). Create it in LicensingPlatform > API clients with exactly these
# scopes: catalog.read customers.manage subscriptions.read subscriptions.manage licenses.read licenses.manage
Licenses__Platform__BaseUrl=https://licensing.example
Licenses__Platform__ClientId=
Licenses__Platform__ClientSecret=
# Deprecated (ADR-007): the old service user. Leave empty once ClientId is set, then disable that user.
Licenses__Platform__ServiceEmail=
Licenses__Platform__ServicePassword=

# The Monitor Cloud user that registers each licensed company (needs platform.tenants.manage).
Licenses__Monitor__BaseUrl=https://cloud.example
Licenses__Monitor__ServiceEmail=
Licenses__Monitor__ServicePassword=

# E5: the company bank account buyers transfer to. Leave AccountHolder empty to turn bank transfer off. Never commit
# real values; staff approve each reported transfer in the admin Orders screen before a license is issued.
Commerce__BankTransfer__AccountHolder=
Commerce__BankTransfer__BankName=
Commerce__BankTransfer__AccountNumber=
Commerce__BankTransfer__Iban=
Commerce__BankTransfer__Swift=
Commerce__BankTransfer__Instructions=

# The public half of the release-signing key, base64 SPKI (ADR-009).
Releases__PublicKey=

# The first admin account. Remove both lines after the first sign-in (launch checklist, section 2).
Identity__BootstrapAdminEmail=
Identity__BootstrapAdminPassword=

# The password of keys/dataprotection.pfx, the certificate that encrypts the sign-in keys in the database (deploy.md).
Identity__KeyProtection__CertificatePassword=

# Only with `docker compose --profile db`: SQL Server on this machine.
SQL_SA_PASSWORD=
